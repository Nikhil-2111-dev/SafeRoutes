{
  "name": "saferoute-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --project amplify/tsconfig.json --noEmit",
    "sandbox": "ampx sandbox --outputs-out-dir ../frontend",
    "generate:outputs": "ampx generate outputs --outputs-out-dir ../frontend",
    "generate:graphql-client-code": "ampx generate graphql-client-code --out-dir ../frontend/src/api"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.0",
    "@aws-amplify/backend-cli": "^1.10.0",
    "aws-cdk-lib": "^2.269.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "private": true
}
